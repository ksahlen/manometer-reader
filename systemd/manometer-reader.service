[Unit]
Description=Manometer Reader - Analog gauge to MQTT
Documentation=https://github.com/youruser/manometer-reader
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=manometer
Group=manometer
WorkingDirectory=/opt/manometer-reader/service
ExecStart=/opt/manometer-reader/venv/bin/python service.py
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tmp/manometer-debug
PrivateTmp=yes

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
